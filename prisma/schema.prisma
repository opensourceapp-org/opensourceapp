// OpenSourceApp.org — MVP schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum VerificationSignalType {
  MAINTAINER_ATTESTED
  REPO_ACTIVITY
  PACKAGE_REGISTRY
  SECURITY_AUDIT
  COMMUNITY_ENDORSEMENT
}

enum VerificationSignalStatus {
  PENDING
  ACTIVE
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  submissions   Submission[]       @relation("SubmissionOwner")
  applications  Application[]      @relation("ApplicationSubmitter")
  auditLogs     AuditLog[]
  signals       VerificationSignal[] @relation("SignalRecorder")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  applications ApplicationCategory[]
}

model Platform {
  id   String @id @default(cuid())
  slug String @unique
  name String

  applications ApplicationPlatform[]
}

model License {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  spdxId String?

  applications ApplicationLicense[]
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  applications ApplicationTag[]
}

model Application {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  tagline          String?
  description      String    @db.Text
  homepageUrl      String?
  repositoryUrl    String
  repositoryHost   String?
  defaultBranch    String?
  stars            Int?
  forks            Int?
  lastCommitAt     DateTime?
  primaryLanguage  String?
  logoUrl          String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  submittedById    String?
  submittedBy      User?     @relation("ApplicationSubmitter", fields: [submittedById], references: [id])

  categories ApplicationCategory[]
  platforms  ApplicationPlatform[]
  licenses   ApplicationLicense[]
  tags       ApplicationTag[]
  signals    VerificationSignal[]
  submission Submission?
}

model ApplicationCategory {
  applicationId String
  categoryId    String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([applicationId, categoryId])
}

model ApplicationPlatform {
  applicationId String
  platformId    String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  platform      Platform    @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([applicationId, platformId])
}

model ApplicationLicense {
  applicationId String
  licenseId     String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  license       License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([applicationId, licenseId])
}

model ApplicationTag {
  applicationId String
  tagId         String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([applicationId, tagId])
}

model Submission {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  status           SubmissionStatus @default(DRAFT)
  applicationId    String?          @unique
  application      Application?     @relation(fields: [applicationId], references: [id])
  name             String
  tagline          String?
  description      String           @db.Text
  homepageUrl      String?
  repositoryUrl    String
  repositoryHost   String?
  defaultBranch    String?
  stars            Int?
  forks            Int?
  lastCommitAt     DateTime?
  primaryLanguage  String?
  repoMetadataJson Json?
  reviewerNotes    String?          @db.Text
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model VerificationSignal {
  id            String                   @id @default(cuid())
  applicationId String
  application   Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          VerificationSignalType
  status        VerificationSignalStatus @default(PENDING)
  summary       String
  evidenceUrl   String?
  evidenceJson  Json?
  recordedById  String?
  recordedBy    User?                    @relation("SignalRecorder", fields: [recordedById], references: [id])
  recordedAt    DateTime                 @default(now())
  expiresAt     DateTime?

  @@index([applicationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
