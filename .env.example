# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opensourceapp?schema=public"

# Auth.js — https://authjs.dev
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public site URL (metadata, sitemap, auth callbacks). Production: https://opensourceapp.org
AUTH_URL="http://localhost:3000"

# GitHub OAuth (primary)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic link (optional)
EMAIL_SERVER="smtp://user:pass@localhost:1025"
EMAIL_FROM="noreply@opensourceapp.org"

# Optional: higher GitHub API rate limits for repo metadata fetch
GITHUB_TOKEN=""

# Seed: promote existing user to ADMIN after first sign-in
SEED_ADMIN_EMAIL=""
